SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DOCKER_SOCKET=/var/run/docker.sock
SESSION_SECRET=generate_a_random_secret_with_at_least_32_bytes
VW_CONTAINER_NAME=vaultwarden
RP_ID=localhost
